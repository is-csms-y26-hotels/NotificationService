{
  "Infrastructure": {
    "Persistence": {
      "Postgres": {
        "Host": "localhost",
        "Port": 7432,
        "Database": "postgres",
        "Username": "postgres",
        "Password": "postgres",
        "SslMode": "Prefer",
        "Pooling": true
      }
    },
    "MessagePersistence": {
      "Persistence": {
        "SchemaName": "message_persistence"
      }
    }
  },
  "Presentation": {
    "Kafka": {
      "Host": "localhost:8001",
      "Consumers": {
        "BookingNotifications": {
          "Topic": "booking_notifications",
          "BufferSize": 100,
          "BufferWaitLimit": "00:00:01",
          "ParallelismDegree": 1,
          "Group": "notification-service[booking_notifications]",
          "Inbox": {
            "BatchSize": 100,
            "PollingDelay": "00:00:01",
            "RetryCount": 10
          }
        }
      }
    }
  },
  "Platform": {
    "Environment": "Local"
  }
}
